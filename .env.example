# Copy this file to `.env` and fill in your real values.
# `ml_pipeline/db_backend.py` reads DATABASE_URL from here.

# Neon (serverless PostgreSQL) connection string.
# Neon dashboard -> Connection Details -> Connection string (include sslmode=require).
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/edu_growth?sslmode=require

# Used later by the FastAPI auth layer; not needed for the mentor pipeline yet.
JWT_SECRET_KEY=replace-with-a-local-secret
