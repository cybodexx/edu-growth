# EduGrowth auth service (Express + MongoDB + JWT) configuration.
# Copy to `.env` and fill in real values.  .env is git-ignored.

# MongoDB connection string (Atlas or local).
MONGO_URI=mongodb://127.0.0.1:27017/edu_growth

# Secret used to sign student/faculty JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Port the auth service listens on. The frontend defaults to 5001
# (VITE_AUTH_BASE_URL in frontend/.env), so keep this as 5001 unless you also
# change the frontend env.
PORT=5001

# Comma-separated list of allowed browser origins for CORS.
# Leave empty (or unset) to allow every origin during local development.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Password-reset email (Gmail SMTP). Optional: reset requests still succeed
# without it, but no email is delivered.
EMAIL_USER=youraccount@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Base URL of the frontend, used to build password-reset links.
FRONTEND_URL=http://localhost:5173
